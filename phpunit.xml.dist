<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit tests of the module source (no WHMCS needed). Run: tools/qa.sh unit  (or: php phpunit.phar -c phpunit.xml.dist) -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>modules/addons/TSSGGSModule/app</directory>
        </include>
    </source>
</phpunit>
