{* What the report dialog shows after the report was sent ($text) *}
<div class="lu-modal show modal--zoomIn" data-dialog>
    <div class="lu-modal__dialog">
        <div class="lu-modal__content">
            <div class="lu-modal__body lu-single-element"><div class="tssggs-note is-ok">{$text}</div></div>
            <div class="lu-modal__actions">
                <button type="button" class="lu-btn lu-btn--success" data-dialog-close><span class="lu-btn__text">OK</span></button>
            </div>
        </div>
    </div>
</div>
