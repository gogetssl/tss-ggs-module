{* What the report dialog shows after the report was sent ($text) *}
<div class="mod-modal show mod-modal--zoom" data-dialog>
    <div class="mod-modal-frame">
        <div class="mod-modal-sheet">
            <div class="mod-modal-body mod-solo"><div class="tssggs-note is-ok">{$text}</div></div>
            <div class="mod-modal-foot">
                <button type="button" class="mod-btn mod-btn--success" data-dialog-close><span class="mod-btn-text">OK</span></button>
            </div>
        </div>
    </div>
</div>
