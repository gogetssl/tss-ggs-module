# Only WHMCS runs this module's PHP files: it includes them from disk, so this rule does not touch it.
# A direct web request for one of them is refused. The stylesheet / script builders the browser loads
# (resources/build/css.php, js.php, components.php) stay reachable; images, styles and scripts are not PHP.
# nginx ignores this file - see the release notes for the matching nginx rule.
<FilesMatch "^(?!(css|js|components)\.php$).+\.(php|php[0-9]|phtml|phar|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
