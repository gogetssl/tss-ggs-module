# Static analysis of the module's own code.
# Run: tools/qa.sh stan. Issues that existed when the analysis was introduced are listed in phpstan-baseline.neon;
# new code must not add any. Raise the level step by step (regenerate the baseline with --generate-baseline).
includes:
    - phpstan-baseline.neon

parameters:
    level: 2
    phpVersion: 80100
    paths:
        - modules/addons/TSSGGSModule/app
        - modules/servers/TSSGGSModule/app
        - modules/servers/TSSGGSModule/ClientArea.php
        - modules/servers/TSSGGSModule/Text.php
        - modules/servers/TSSGGSModule/View.php
    excludePaths:
        analyse:
            # thin wrappers of WHMCS's own (encoded) model classes: read for their names, not analysed
            - modules/addons/TSSGGSModule/app/Models/Whmcs
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanDirectories:
        # WHMCS's own libraries that are plain PHP (WHMCS root from QA_WHMCS, see tools/qa.sh)
        - %env.QA_WHMCS%/vendor/illuminate
        - %env.QA_WHMCS%/vendor/symfony/console
        - %env.QA_WHMCS%/vendor/nesbot/carbon
    scanFiles:
        - tests/stubs/whmcs.php
        # global functions the hook classes call (unifiedSslLabelBlock is shared by both editions)
        - modules/servers/TSSGGSModule/hooks.php
    ignoreErrors:
        # Eloquent models and the Capsule facade answer static calls through __callStatic (where, insert, select ...);
        # plain PHPStan can not see them (Larastan would, but needs Composer)
        - '#^Call to an undefined static method (TSSGGSModule\\[A-Za-z\\]+\\[Mm]odels\\[A-Za-z\\]+|WHMCS\\Database\\Capsule|WHMCS\\(Service|User|Mail)\\[A-Za-z]+)::[a-zA-Z]+\(\)\.$#'
        - '#^Access to an undefined property (TSSGGSModule\\[A-Za-z\\]+\\[Mm]odels\\[A-Za-z\\]+|Illuminate\\Database\\Eloquent\\Builder\|Illuminate\\Database\\Eloquent\\Model)::\$[a-zA-Z_]+\.$#'
        # WHMCS's own function files, loaded at runtime from the WHMCS root (ROOTDIR/includes/...)
        - '#^Path in require_once\(\) "[^"]*/includes/[a-z]+\.php" is not a file or it does not exist\.$#'
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
